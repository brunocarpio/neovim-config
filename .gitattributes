# Cross-platform line ending normalization
# All text files use LF in the repo, converted to native on checkout

* text=auto eol=lf

# Explicitly mark file types as text
*.lua text
*.vim text
*.md text
*.json text
*.yaml text
*.yml text
*.toml text

# Ensure shell scripts use LF even on Windows
*.sh text eol=lf

# Keep batch/powershell scripts with CRLF for Windows compatibility
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary

# Lock files - keep exact formatting
lazy-lock.json text eol=lf -diff merge=ours
